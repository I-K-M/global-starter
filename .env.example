# Local Docker Compose database. Generate a password with: openssl rand -hex 32
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
# Replace the password below with the same URL-safe value as POSTGRES_PASSWORD.
DATABASE_URL=postgres://app_user:REPLACE_WITH_SAME_PASSWORD@127.0.0.1:5432/global_starter
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Global Starter
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Global Starter
CONTACT_TO_EMAIL=
CRON_SECRET=
PREVIEW_SECRET=replace-with-at-least-32-random-characters
